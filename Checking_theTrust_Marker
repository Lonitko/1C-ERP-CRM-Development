
&После("ПриСозданииНаСервере")
Процедура СБ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	// ● 1. Программное добавление Поля Ввода
	ИмяПоля = "ПрограммноеПолеМаркерНадежности";
	Если Элементы.Найти(ИмяПоля) = Неопределено Тогда
		
		// Добавляем в корень формы (в качестве родителя передаем ЭтотОбъект)
		НовоеПоле = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), ЭтотОбъект);
		НовоеПоле.Вид = ВидПоляФормы.ПолеВвода;
		НовоеПоле.ПутьКДанным = "Объект.СБ_МаркерНадежности"; 
		НовоеПоле.Заголовок = "Маркер надежности";
		
		// Перемещаем в самый верх формы
		Элементы.Переместить(НовоеПоле, ЭтотОбъект);
	КонецЕсли;
	
	ИмяПоля = "ПрограммноеПолеОГРН";
	Если Элементы.Найти(ИмяПоля) = Неопределено Тогда
		
		// Добавляем в корень формы (в качестве родителя передаем ЭтотОбъект)
		НовоеПоле = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), ЭтотОбъект);
		НовоеПоле.Вид = ВидПоляФормы.ПолеВвода;
		НовоеПоле.ПутьКДанным = "Объект.СБ_ОГРН"; 
		НовоеПоле.Заголовок = "ОГРН";
		
		// Перемещаем в самый верх формы
		Элементы.Переместить(НовоеПоле, ЭтотОбъект);
	КонецЕсли;
	
	// ● 2. Программное добавление Кнопки
	ИмяКнопки = "ПрограммнаяКнопкаОбновитьМаркер";
	Если Элементы.Найти(ИмяКнопки) = Неопределено Тогда
		
		НоваяКоманда = Команды.Добавить("КомандаОбновитьМаркер");
		НоваяКоманда.Действие = "Подключаемый_ОбновитьМаркер";
		НоваяКоманда.Заголовок = "Обновить маркер";
		
		// ИСПРАВЛЕНО: Ищем стандартное имя главной панели кнопок управляемой формы
		ПанельКнопок = Элементы.Найти("ФормаКоманднаяПанель");
		
		// Если стандартную панель кнопок найти не удалось, родителем делаем саму форму
		РодительКнопки = ?(ПанельКнопок <> Неопределено, ПанельКнопок, ЭтотОбъект);
		
		НоваяКнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), РодительКнопки);
		НоваяКнопка.ИмяКоманды = "КомандаОбновитьМаркер";
		
		Если ПанельКнопок <> Неопределено Тогда
			НоваяКнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		Иначе
			НоваяКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
			Элементы.Переместить(НоваяКнопка, ЭтотОбъект, НовоеПоле);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
// ● 3. Обработчик нажатия кнопки на клиенте
&НаКлиенте
Процедура Подключаемый_ОбновитьМаркер(Команда)
	
	ОГРНКонтрагента = Объект.СБ_ОГРН;  	
	
	Если ПустаяСтрока(ОГРНКонтрагента) Тогда
		ПоказатьПредупреждение(, "Не указан ОГРН контрагента! Запрос не может быть выполнен.");
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Попытка
			ЭтотОбъект.Записать();
		Исключение
			ПоказатьПредупреждение(, "Не удалось записать контрагента: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	РезультатОбновления = ВыполнитьЗапросКСервисуНаСервере(ОГРНКонтрагента);
	Сообщить( РезультатОбновления);
	
КонецПроцедуры

// ● 4. Серверная функция для HTTP-запроса, разбора условий и заполнения маркера
&НаСервере
Функция ВыполнитьЗапросКСервисуНаСервере(Знач ОГРН)
	
	ТестовыйКлюч = ""; //вводится ключ
	ИмяСервера = "api.datanewton.ru";
	АдресРесурса = "/v1/counterparty?key=" + ТестовыйКлюч + "&ogrn=" + СокрЛП(ОГРН);
	
	Соединение = Новый HTTPСоединение(ИмяСервера, 443, , , , 15, Новый ЗащищенноеСоединениеOpenSSL());
	Запрос = Новый HTTPЗапрос(АдресРесурса);
	
	Попытка
		Ответ = Соединение.Получить(Запрос);
		
		Если Ответ.КодСостояния = 301 Или Ответ.КодСостояния = 302 Тогда
			НовыйАдрес = Ответ.Заголовки.Получить("Location");
		КонецЕсли;
		
		Если Ответ.КодСостояния <> 200 Тогда
			
		КонецЕсли;
		
		СтрокаОтветаJSON = Ответ.ПолучитьТелоКакСтроку();
	Исключение
	КонецПопытки;
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	CodeEgr = ПолучитьЗначениеПоКлючу(ДанныеОтвета, "code_egr");
	DissolvedDate = ПолучитьЗначениеПоКлючу(ДанныеОтвета, "dissolved_date");
	NegativeLists = ПолучитьЗначениеПоКлючу(ДанныеОтвета, "negative_lists");
	PublicationDate = ПолучитьЗначениеПоКлючу(ДанныеОтвета, "publication_date");
	
	НовыйМаркер = Перечисления.СБ_СтатусыНадежности.Надежный;
	
	Если CodeEgr = "001" Тогда
		НовыйМаркер = Перечисления.СБ_СтатусыНадежности.Ненадежный;
	ИначеЕсли DissolvedDate <> Неопределено Тогда
		НовыйМаркер = Перечисления.СБ_СтатусыНадежности.Ненадежный;
	ИначеЕсли NegativeLists <> Неопределено Тогда
		НовыйМаркер = Перечисления.СБ_СтатусыНадежности.Сомнительный;
	ИначеЕсли PublicationDate = Неопределено Тогда
		НовыйМаркер = Перечисления.СБ_СтатусыНадежности.Сомнительный;
	КонецЕсли;
	
	Объект.СБ_МаркерНадежности = НовыйМаркер;
	
	//  ЗАПИСЬ В РЕГИСТР СВЕДЕНИЙ
	
	ТекущийКонтрагент = Объект.Ссылка;
	
	Если ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		
		
		НаборЗаписей = РегистрыСведений.СБ_ИсторияМаркеровНадежности.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Период.Установить(НачалоДня(ТекущаяДата()));
		НаборЗаписей.Отбор.Контрагент.Установить(ТекущийКонтрагент);
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Период     = НачалоДня(ТекущаяДата());
		НоваяЗапись.Контрагент = ТекущийКонтрагент;
		НоваяЗапись.Статус     = НовыйМаркер;
		
		Попытка
			НаборЗаписей.Записать(Истина); 
		Исключение
			ЗаписьЖурналаРегистрации("СБ.РегистрИсторииМаркеров", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
			ВызватьИсключение; 
		КонецПопытки;
	КонецЕсли;
	Возврат "Маркер надежности успешно обновлен в базе и регистре.";	
КонецФункции

Функция ПолучитьЗначениеПоКлючу(Структура, Ключ)
	Значение = Неопределено;
	Если Структура.Свойство(Ключ, Значение) Тогда
		Возврат Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции
